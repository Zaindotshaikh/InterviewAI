LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BACKEND_URL=http://127.0.0.1:3001
V2_INTERNAL_SECRET=pick-a-long-random-string
V2_AGENT_NAME=interview-v2
V2_MAX_MINUTES=25

# Providers: mix and match per component (openai | sarvam | google | mock | elevenlabs_scribe)
PROVIDER_MODE=openai
# openai (default) | elevenlabs_scribe (Scribe v2 realtime A/B) | sarvam | mock
STT_PROVIDER=openai
# If elevenlabs_scribe fails to build, fall back (openai | none)
STT_SCRIBE_FALLBACK=openai
# Persist turn.latency events (ttfa_vad_ms headline + ttfa_confirm_ms)
VOICE_LATENCY_LOG=true
# legacy = LLM writes EL tags | engine = post-processor ≤1 tag (EL path)
VOICE_EXPRESSIVENESS=engine
VOICE_TRANSCRIPT_SPLIT=true
DIRECTOR_EMPATHY_TONE=false
VOICE_EARLY_FILLER=false
THINKING_SOUND_ENABLED=true
TTS_FALLBACK_ON_ERROR=google
TTS_PROVIDER=google
LLM_PROVIDER=openai
# Voice wording only — keep DIRECTOR_MODEL=gpt-4o for analysis.
LLM_MODEL=gpt-4o-mini
# Streaming httpx read timeout (LiveKit OpenAI plugin default is 5s — too tight).
LLM_HTTP_TIMEOUT_SECONDS=25
# LiveKit LLM retries after timeout (1 = one retry; avoid stacking long mute).
LLM_MAX_RETRY=1
# Optional second model if primary errors (leave empty to disable).
# LLM_FALLBACK_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-live-transcribe
# Full-duplex GPT-Live path (/gpt-live-interviewer) — needs GPT-Live alpha access on the key
# No Indic-native stock voice; Indian English is prompt-driven. Stronger: approved custom voice.
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=marin
# Optional per-language voice A/B: hi-IN:marin,en-IN:beacon,ta-IN:marin
# GPT_LIVE_VOICE_BY_LANG=
# Approved OpenAI custom voice (voice_...) + instructions "Speak Indian English" — contact sales for access
# GPT_LIVE_CUSTOM_VOICE_ID=


# Google Chirp 3 HD voices (TTS_PROVIDER=google)
# Prefer ADC when org blocks SA keys:
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT_ID
# Optional JSON key path (only if your org allows key creation):
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_TTS_VOICE=Kore
GOOGLE_SPEAKING_RATE=1.0
# chirp_3 (fastest, ~0.3s) | gemini-2.5-flash-tts (more expressive, ~1s; hi/mr/ta/te/en only)
GOOGLE_TTS_MODEL=chirp_3
GOOGLE_CLOUD_PROJECT=

# ElevenLabs (opt-in via /elevenlabs-interviewer or TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
# Sarah (English premade). Library voices need a paid plan for API use.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Alice (premade, free API) for Indic. Sujata 4mCfn38CsM9hGLvDrPxv needs a paid plan.
# ELEVENLABS_VOICE_ID_LOCAL=Xb7hH8MSUJpSbSDYk0k2
# eleven_v4_turbo (realtime) | eleven_v4 (max quality)
ELEVENLABS_MODEL=eleven_v4_turbo

# Short native reaction ("बरं.", "अच्छा.") in the interview voice after ~60% of substantive answers. 0 = off
THINKING_FILLER_PROBABILITY=0.6
THINKING_SOUND_VOLUME=0.25
# Unused (greeting never starts with a filler)
OPENING_HESITATION=false
# Chance a reply keeps the single "umm," the LLM placed mid-sentence. 0 = never
HESITATION_RATE=0.7
# Chance each phrase boundary (comma, conjunction, long run) becomes a real pause (0 = off)
PHRASE_PAUSE_RATE=0.85

# Turn-taking (when the agent decides you finished, and when it yields the floor)
# Semantic end-of-turn model: only covers hi/en; other languages use the higher floor below
TURN_DETECTOR_ENABLED=true
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY=0.4
ENDPOINTING_MIN_DELAY_UNCOVERED=0.8
ENDPOINTING_MAX_DELAY=3.0
ENDPOINTING_ALPHA=0.7
# adaptive = ignores "hmm/haan" backchannels, yields to real interruptions; vad = any sound interrupts
INTERRUPTION_MODE=adaptive
# Need this many STT words before barge-in (keeps interviewer talking through ambient noise)
INTERRUPTION_MIN_WORDS=2
INTERRUPTION_MIN_WORDS_NO_ALIGN=3
# No confirmed speech within this window → resume interviewer mid-sentence
FALSE_INTERRUPTION_TIMEOUT=1.8
# After resume, ignore brief junk transcripts so Flow does not jump
FALSE_INTERRUPT_DISCARD_SECONDS=1.2
# Off: our per-turn controller directive invalidates preemptive generations anyway
PREEMPTIVE_GENERATION=false
# Speech heard but no transcript after this many seconds -> ask the candidate to repeat
TRANSCRIPTION_TIMEOUT_SECONDS=3.0
MAX_REPEAT_PROMPTS=3
# Do not let ambient noise barge the greeting; settle briefly before first answer.
OPENING_BLOCK_INTERRUPTIONS=true
OPENING_SETTLE_SECONDS=0.8

# Sarvam (switch STT_PROVIDER / TTS_PROVIDER / LLM_PROVIDER to sarvam)
SARVAM_API_KEY=

# krisp = Krisp BVC (bg voices + noise) | aicoustics = Quail Voice Focus L | none
NOISE_PROVIDER=krisp
# Optional for aicoustics path (if your LiveKit/ai-coustics setup requires it)
# AIC_SDK_LICENSE=

# --- Interview director: reads each answer and steers the interview (see agent/interview/) ---
DIRECTOR_MODEL=gpt-4o
CLINICAL_DIRECTOR_MODEL=gpt-4o
DIRECTOR_TIMEOUT_SECONDS=4.5
# Seconds of candidate silence before the first nudge (then escalates: rephrase, check, end as incomplete)
SILENCE_NUDGE_SECONDS=12
# How long a dropped candidate has to rejoin before the interview is ended as incomplete
RECONNECT_GRACE_SECONDS=120
